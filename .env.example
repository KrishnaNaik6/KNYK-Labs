# ==========================================
# KNYK Labs Public Website Environment Variables
# ==========================================

# NEXIS Central Control Center API
# Server-side only (Do NOT prefix with NEXT_PUBLIC)
NEXIS_API_URL=https://nexis-api.example.com
NEXIS_REVALIDATE_SECONDS=60

# Optional: Upstream API request timeout in milliseconds (defaults to 10000)
# Helpful to absorb cold starts on serverless or Render starter instances
NEXIS_TIMEOUT_MS=10000

# Public Site URL (for SEO / Canonical / OG tags)
NEXT_PUBLIC_SITE_URL=https://knyklabs.com

